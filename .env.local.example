# Development Environment Variables
# Copy this to .env.local for local development
# This file is automatically ignored by git

# Database Configuration
DATABASE_URL="postgresql://localhost:5432/fooxchange_dev"

# Clerk Authentication (Use Test Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_development_key"
CLERK_SECRET_KEY="sk_test_development_key"

# UploadThing (Test Environment)
UPLOADTHING_SECRET="sk_test_development_secret"
UPLOADTHING_APP_ID="test_app_id"

# CORS (Development - Allow localhost)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
