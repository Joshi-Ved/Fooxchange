# Fooxchange - Database Configuration
# Copy this file to .env and fill in your values

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# For local development with Docker: postgresql://postgres:postgres@localhost:5432/fooxchange
# For Supabase: Get from Supabase dashboard -> Settings -> Database -> Connection String (Direct)
# For Neon: Get from Neon console -> Connection Details -> Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fooxchange?schema=public"

# Clerk Authentication (Required for Phase 2)
# Get from: https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Uploadthing (Required for Image Uploads)
# Get from: https://uploadthing.com/dashboard
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_APP_ID="..."

# Security (Optional - for production)
# Comma-separated list of allowed origins for CORS
# Example: "https://fooxchange.com,https://www.fooxchange.com"
# Leave empty or set to "*" for development
ALLOWED_ORIGINS="*"
