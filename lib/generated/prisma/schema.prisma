// Fooxchange Database Schema
// Production-grade schema for recipe sharing platform
// See PLAN.md for architecture details

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model - Managed by Clerk for auth, but we store additional metadata
model User {
  id        String   @id @default(cuid()) // Using cuid for better distribution
  clerkId   String   @unique // Clerk user ID for auth mapping
  email     String   @unique
  name      String
  avatarUrl String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  recipes      Recipe[] // Recipes authored by this user
  savedRecipes SavedRecipe[] // Recipes saved/favorited by user
  visionLogs   VisionLog[] // Vision scan history

  @@index([clerkId])
  @@index([email])
}

// Recipe model - Core entity
model Recipe {
  id          String     @id @default(cuid())
  title       String
  description String     @db.Text
  imageUrl    String?
  prepTime    Int? // in minutes
  cookTime    Int? // in minutes
  servings    Int        @default(4)
  difficulty  Difficulty @default(EASY)

  // Foreign keys
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ingredients     RecipeIngredient[]
  steps           Step[]
  savedBy         SavedRecipe[]
  recipeEmbedding RecipeEmbedding?

  // Indexes for performance
  @@index([authorId])
  @@index([difficulty])
  @@index([createdAt]) // For sorting by newest
}

// Ingredient model - Normalized ingredient catalog
model Ingredient {
  id       String  @id @default(cuid())
  name     String  @unique // Normalized name e.g., "Tomato"
  slug     String  @unique // URL-friendly e.g., "tomato"
  category String? // e.g., "Vegetable", "Spice", "Dairy"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  recipes             RecipeIngredient[]
  ingredientEmbedding IngredientEmbedding?

  @@index([slug])
  @@index([category])
}

// Join table for many-to-many between Recipe and Ingredient
// Includes additional metadata like quantity
model RecipeIngredient {
  id String @id @default(cuid())

  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  amount     String // e.g., "2 cups", "1 tbsp", "to taste"
  isOptional Boolean @default(false)

  createdAt DateTime @default(now())

  // Composite unique constraint - each ingredient can appear only once per recipe
  @@unique([recipeId, ingredientId])
  @@index([recipeId])
  @@index([ingredientId])
}

// Step model - Ordered cooking instructions
model Step {
  id String @id @default(cuid())

  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  order    Int // Step number (1, 2, 3, etc.)
  content  String  @db.Text // The instruction text
  imageUrl String? // Optional step-specific image

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Unique constraint - each recipe can have each step number only once
  @@unique([recipeId, order])
  @@index([recipeId])
}

// SavedRecipe - User's saved/favorited recipes
model SavedRecipe {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  savedAt DateTime @default(now())

  // Prevent duplicate saves
  @@unique([userId, recipeId])
  @@index([userId])
  @@index([recipeId])
}

// ============================================
// PHASE 2: AI Vision & Vector Search Models
// ============================================

// IngredientEmbedding - Stores vector representations of ingredients
// Used for semantic matching (e.g., "cilantro" matches "coriander")
model IngredientEmbedding {
  id String @id @default(cuid())

  ingredientId String     @unique
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  // Vector representation (OpenAI text-embedding-3-small uses 1536 dimensions)
  embedding String @db.Text // Stored as JSON array, converted to pgvector in queries

  // Metadata for enhanced matching
  metadata Json? // { flavorProfile: ["spicy", "aromatic"], synonyms: [...] }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ingredientId])
}

// RecipeEmbedding - Stores vector representations of entire recipes
// Used for semantic recipe discovery ("I want something comforting")
model RecipeEmbedding {
  id String @id @default(cuid())

  recipeId String @unique
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  // Vector combining title + description + ingredients
  embedding String @db.Text // Stored as JSON array

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recipeId])
}

// VisionLog - Analytics and debugging for computer vision feature
// Helps improve accuracy over time
model VisionLog {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  imageUrl      String? // Temporary URL (auto-deleted after 24h)
  detectedItems Json // Array of detected ingredients with confidence scores
  latencyMs     Int // Processing time for performance monitoring

  // User feedback (did they confirm/edit the results?)
  userConfirmed Boolean @default(false)
  userEdits     Json? // What corrections user made

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt]) // For analytics queries
}

// Enums
enum Difficulty {
  EASY
  MEDIUM
  HARD
}
